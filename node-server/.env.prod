# [Server Configuration]
NODE_ENV=production
PORT=80

# [Security - JWT]
# 설계서 규정대로 보안 강화를 위해 1시간 설정
JWT_SECRET=prod_very_long_and_complex_random_string_do_not_leak
JWT_EXPIRATION=1h

# [FIDO2 / WebAuthn]
# 실제 도메인이 결정되면 해당 도메인으로 변경
RP_ID=your-project-domain.com
RP_NAME="SecureAuth_Service"
EXPECTED_ORIGIN=https://your-project-domain.com

# [Database - MySQL]
DB_HOST=db
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=prod_secure_password_13579!
DB_NAME=rp_server_db

# [Cache - Redis]
REDIS_HOST=redis
REDIS_PORT=6379
CHALLENGE_TTL=90

# [AI Service]
AI_RISK_API_URL=http://python-risk:5000/analyze

# TTL (초 단위)
CHALLENGE_TTL=60
SESSION_TTL=1800
SESSION_ABSOLUTE_TTL=28800
REAUTH_TTL=180
BLOCK_TTL=86400
RISK_TTL=300